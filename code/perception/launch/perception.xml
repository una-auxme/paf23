<launch>
  <arg name="role_name" default="hero" />
  <arg name="control_loop_rate" default="0.05" />
  <arg name="view_camera" default="False" />
  <arg name="camera_resolution" default="1280" />

  <node pkg="perception" exec="vision_node" name="VisionNode">
    <param name="role_name" value="$(var role_name)" />
    <param name="view_camera" value="$(var view_camera)" />
    <param name="camera_resolution" value="$(var camera_resolution)"/>
    <param from="$(find-pkg-share perception)/config/perception.yaml"/>

    <!--
        Object-detection models (torchvision, BSD-3-Clause):
      - fasterrcnn_resnet50_fpn_v2       (best accuracy)
      - fasterrcnn_mobilenet_v3_large_320_fpn (fastest)
      - retinanet_resnet50_fpn_v2

        Previously used AGPL-3.0 ultralytics (YOLOv8/YOLO11) models were
        removed for license compatibility with this MIT project.
      -->

    <param name="model" value="fasterrcnn_resnet50_fpn_v2" />
    <param name="score_threshold" value="0.5" />
  </node>

  <node pkg="perception" exec="traffic_light_node" name="TrafficLightNode">
    <param name="role_name" value="$(var role_name)" />
    <param name="side" value="Center" />
    <param name="model" value="/workspace/code/perception/traffic_light_detection/models/model_acc_92.48_val_91.88.pt" />
    <param name="tfs_debug" value="False"/>
  </node>

  <node pkg="perception" exec="lidar_distance" name="lidar_distance">
    <!-- Cluster configuration -->
    <param name="activate_normalization" value="True" />
    <param name="clustering_w" value="0.0285" />
    <param name="clustering_lidar_z_min" value="-1.4" />
    <param name="clustering_lidar_z_max" value="1.5" />
    <param name="dbscan_eps" value="0.03375" />
    <param name="dbscan_min_samples" value="10" />
    <param name="compensation_strategy" value="LocalCompensation" />
  </node>

  <node pkg="perception" exec="Lanedetection_node" name="Lanedetection">
    <param name="role_name" value="$(var role_name)" />
  </node>

  <node pkg="perception" exec="radar_node" name="radar_node">
    <param name="dbscan_eps" value="0.3"/>
    <param name="dbscan_samples" value="1"/>
    <param name="data_buffered" value="False"/>
    <param name="data_buffer_time" value="0.1"/>
    <param name="imu_debug" value="False"/>
    <param name="accelerometer_arrow_size" value="2.0"/>
    <param name="accelerometer_factor" value="0.05"/>
    <param name="enable_clustering" value="False"/>
    <param name="enable_debug_info" value="False"/>
  </node>


  <node pkg="perception" exec="lane_position" name="lane_position">
    <param name="epsilon" value="1.8"/>
    <param name="min_samples" value="4"/>
    <param name="confidence_threshold" value="0.6"/>
    <param name="angle_weight" value="0.3"/>
    <param name="size_weight" value="0.3"/>
    <param name="std_dev_weight" value="0.4"/>
    <param name="angle_normalization" value="25.0"/>
    <param name="size_normalization" value="15.0"/>
    <param name="std_dev_normalization" value="0.1"/>
    <param name="angle_prediction_threshold" value="5.0"/>
    <param name="y_tolerance" value="1.0"/>
    <param name="line_length" value="15.0"/>
    <param name="line_width" value="0.5"/>
  </node>

</launch>
